"""Bazel library for the frozen Ouroboros v1 Go contract messages."""

load("@rules_go//go:def.bzl", "go_library")

exports_files(
    ["BUILD.bazel"],
    visibility = ["//packages/contracts:__pkg__"],
)

filegroup(
    name = "generated_outputs",
    srcs = glob([
        "*.pb.go",
        "contractsv1connect/*.go",
    ]),
    visibility = ["//packages/contracts:__pkg__"],
)

go_library(
    name = "contracts",
    srcs = glob(["*.pb.go"]),
    importpath = "github.com/sltbrta/sentra-code-memory-v2/packages/contracts/gen/go/ouroboros/contracts/v1",
    visibility = ["//visibility:public"],
    deps = [
        "@build_buf_gen_go_bufbuild_protovalidate_protocolbuffers_go//buf/validate",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//runtime/protoimpl",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
