{
  "$defs": {
    "ouroboros.contracts.v1.Identifier.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Identifier is an opaque, stable identifier within a declared namespace.",
      "properties": {
        "namespace": {
          "description": "namespace prevents an identifier string from crossing a domain boundary.",
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "value": {
          "description": "value is opaque to consumers and must be non-empty after boundary validation.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "value"
      ],
      "title": "Identifier",
      "type": "object"
    },
    "ouroboros.contracts.v1.PurgeConnectorSuccess.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "PurgeConnectorSuccess confirms purge completion.",
      "properties": {
        "connectionId": {
          "$ref": "#/$defs/ouroboros.contracts.v1.Identifier.jsonschema.strict.json",
          "description": "connection_id is the opaque purged connection identity."
        },
        "purgedObjectCount": {
          "description": "purged_object_count is the number of evidence objects purged.",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "state": {
          "description": "state is always PURGED on success.",
          "enum": [
            "CONNECTOR_LIFECYCLE_STATE_PURGED"
          ],
          "title": "Connector Lifecycle State",
          "type": "string"
        }
      },
      "required": [
        "connectionId",
        "state",
        "purgedObjectCount"
      ],
      "title": "Purge Connector Success",
      "type": "object"
    }
  },
  "$id": "ouroboros.contracts.v1.PurgeConnectorSuccess.jsonschema.strict.bundle.json",
  "$ref": "#/$defs/ouroboros.contracts.v1.PurgeConnectorSuccess.jsonschema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
