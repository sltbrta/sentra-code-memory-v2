"""Package-local Bazel adapter for the Stage 1 code-index smoke boundary."""

load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "stage1_receipt_fixtures",
    srcs = [
        "tests/expected_receipt.json",
        "tests/receipt_matrix.tsv",
    ],
)

filegroup(
    name = "stage1_rust_boundary_sources",
    srcs = [
        "Cargo.lock",
        "Cargo.toml",
    ] + glob([
        "src/**",
        "tests/**",
    ]),
)

sh_test(
    name = "stage1_smoke",
    srcs = ["bazel_smoke.sh"],
    data = [":stage1_rust_boundary_sources"],
    tags = [
        "local",
        "ouroboros_affected",
        "ouroboros_check",
        "ouroboros_requires_pinned_rust_toolchain",
        "ouroboros_test",
    ],
)
