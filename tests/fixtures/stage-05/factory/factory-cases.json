  "cases": [
    {
      "caseId": "happy-path-retained",
      "category": "happy_path",
      "intent": {
        "summary": "Rename the seeded marker accessor in two Go files and update their tests.",
        "scopePaths": ["src/go/modify-00.go", "src/go/modify-01.go"]
