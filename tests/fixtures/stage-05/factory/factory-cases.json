      "leaves": [
        {"nodeId": "leaf-a", "ownedPaths": ["src/go/modify-00.go"]},
        {"nodeId": "leaf-b", "ownedPaths": ["src/go/modify-01.go"]}
      ],
      "interference": "none",
      "gates": [
        {"kind": "BUILD", "required": true, "expectedStatus": "PASSED"},
        {"kind": "TEST", "required": true, "expectedStatus": "PASSED"},
        {"kind": "DOCS", "required": true, "expectedStatus": "PASSED"},
        {"kind": "SECURITY", "required": true, "expectedStatus": "PASSED"}
      ],
      "obligations": [
        {"language": "go", "docsRequired": true, "testsRequired": true}
      ],
      "expectedOutcome": "candidate_retained",
      "expectedPublicReason": null,
      "expectedRunState": "COMPLETED",
      "expectedCandidateState": "RETAINED",
      "canonicalUnchanged": true,
      "note": "One approved intent becomes one two-leaf DAG and one verified, reviewed, retained atomic candidate; canonical Git is never mutated by the candidate boundary."
    },
    {
