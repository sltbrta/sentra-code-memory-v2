      "expectedRunState": "PLANNING",
      "expectedCandidateState": null,
      "canonicalUnchanged": true,
      "duplicateSemantics": {
        "exactReplay": "original_outcome",
        "conflictingReuse": "rejected"
      },
      "note": "An exact authenticated replay resolves the admitted key to its original outcome; a conflicting key reuse rejects without mutation."
