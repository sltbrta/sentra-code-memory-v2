      "expectedPublicReason": "not_found_or_denied",
      "expectedRunState": null,
      "expectedCandidateState": null,
      "canonicalUnchanged": true,
      "note": "Admission revalidates the exact base; a stale base rejects with the static non-disclosing denial and no run opens."
    },
    {
      "caseId": "stale-lease-rejected",
      "category": "stale_lease",
      "intent": {
        "summary": "Commit a leaf result under an expired lease fence.",
        "scopePaths": ["src/go/modify-00.go"]
      },
      "leaves": [
        {"nodeId": "leaf-a", "ownedPaths": ["src/go/modify-00.go"]}
