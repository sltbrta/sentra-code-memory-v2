{
  "schemaVersion": "ouroboros.stage11.multimodal-cases.v1",
  "bounds": {
    "textMarkdownMaxBytes": 1048576,
    "pdfMaxBytes": 26214400,
    "pdfMaxPages": 100,
    "pngMaxBytes": 20971520,
    "pngMaxMegapixels": 25,
    "pcmWavMaxBytes": 262144000,
    "pcmWavMaxDurationMillis": 3600000
  },
  "preDecodeReasons": [
    "oversized",
    "malformed",
    "media_type_mismatch",
    "encrypted_or_unsupported",
    "partial_payload",
    "not_found_or_denied"
  ],
  "identityDenialReason": "not_found_or_denied",
  "cases": [
    {
      "caseId": "text-valid-ready",
      "family": "text_markdown",
      "kind": "TEXT_MARKDOWN",
      "mediaType": "text/markdown",
      "byteLength": 128,
      "category": "happy_path",
      "interference": "none",
      "expectedOutcome": "admitted",
      "expectedPublicReason": null,
      "expectedState": "READY",
      "anchorKinds": ["text"],
      "note": "Valid Markdown within 1 MiB admits and reaches ready with offset anchors."
    },
    {
      "caseId": "pdf-valid-ready",
      "family": "pdf",
      "kind": "PDF",
      "mediaType": "application/pdf",
      "byteLength": 4096,
      "pageCount": 3,
      "category": "happy_path",
      "interference": "none",
      "expectedOutcome": "admitted",
      "expectedPublicReason": null,
      "expectedState": "READY",
      "anchorKinds": ["page"],
      "note": "Valid PDF within 25 MiB/100 pages admits with page anchors."
    },
    {
      "caseId": "png-valid-ready",
      "family": "png",
      "kind": "PNG",
      "mediaType": "image/png",
      "byteLength": 8192,
      "widthPx": 800,
      "heightPx": 600,
      "category": "happy_path",
      "interference": "none",
      "expectedOutcome": "admitted",
      "expectedPublicReason": null,
      "expectedState": "READY",
      "anchorKinds": ["page"],
      "note": "Valid PNG within 20 MiB/25 MP admits with region anchors (page bounds)."
    },
    {
      "caseId": "wav-valid-ready",
      "family": "pcm_wav",
      "kind": "PCM_WAV",
      "mediaType": "audio/wav",
      "byteLength": 48000,
      "durationMillis": 1000,
      "sampleRateHz": 16000,
      "channels": 1,
      "category": "happy_path",
      "interference": "none",
      "expectedOutcome": "admitted",
      "expectedPublicReason": null,
      "expectedState": "READY",
      "anchorKinds": ["audio"],
      "note": "Valid PCM WAV within 250 MiB/60m admits with time anchors; no speaker identity."
    },
    {
      "caseId": "text-oversized",
      "family": "text_markdown",
      "kind": "TEXT_MARKDOWN",
      "mediaType": "text/plain",
      "byteLength": 1048577,
      "category": "oversized",
      "interference": "oversized",
      "expectedOutcome": "rejected",
      "expectedPublicReason": "oversized",
      "expectedState": null,
      "note": "Text over 1 MiB fails loud before decode."
    },
    {
      "caseId": "pdf-oversized-pages",
      "family": "pdf",
      "kind": "PDF",
      "mediaType": "application/pdf",
      "byteLength": 1024,
      "pageCount": 101,
      "category": "oversized",
      "interference": "oversized",
      "expectedOutcome": "rejected",
      "expectedPublicReason": "oversized",
      "expectedState": null,
      "note": "PDF over 100 pages fails loud before decode."
    },
    {
      "caseId": "png-oversized-megapixels",
      "family": "png",
      "kind": "PNG",
      "mediaType": "image/png",
      "byteLength": 1024,
      "widthPx": 6000,
      "heightPx": 5000,
      "category": "oversized",
      "interference": "oversized",
      "expectedOutcome": "rejected",
      "expectedPublicReason": "oversized",
      "expectedState": null,
      "note": "PNG over 25 MP fails loud before decode."
    },
    {
      "caseId": "wav-oversized-duration",
      "family": "pcm_wav",
      "kind": "PCM_WAV",
      "mediaType": "audio/wav",
      "byteLength": 1024,
      "durationMillis": 3600001,
      "sampleRateHz": 16000,
      "channels": 1,
      "category": "oversized",
      "interference": "oversized",
      "expectedOutcome": "rejected",
      "expectedPublicReason": "oversized",
      "expectedState": null,
      "note": "WAV over 60 minutes fails loud before decode."
    },
    {
      "caseId": "pdf-malformed",
      "family": "pdf",
      "kind": "PDF",
      "mediaType": "application/pdf",
      "byteLength": 64,
      "pageCount": 1,
      "category": "malformed",
      "interference": "malformed",
      "expectedOutcome": "rejected",
      "expectedPublicReason": "malformed",
      "expectedState": null,
      "note": "Malformed PDF descriptor fails loud before expensive parse."
    },
    {
      "caseId": "png-media-type-mismatch",
      "family": "png",
      "kind": "PNG",
      "mediaType": "image/jpeg",
      "byteLength": 1024,
      "widthPx": 100,
      "heightPx": 100,
      "category": "media_type_mismatch",
      "interference": "media_type_mismatch",
      "expectedOutcome": "rejected",
      "expectedPublicReason": "media_type_mismatch",
      "expectedState": null,
      "note": "JPEG declared as PNG kind mismatches and is rejected (DEF-010)."
    },
    {
      "caseId": "wav-encrypted-or-unsupported",
      "family": "pcm_wav",
      "kind": "PCM_WAV",
      "mediaType": "audio/mpeg",
      "byteLength": 1024,
      "durationMillis": 1000,
      "sampleRateHz": 44100,
      "channels": 2,
      "category": "encrypted_or_unsupported",
      "interference": "encrypted_or_unsupported",
      "expectedOutcome": "rejected",
      "expectedPublicReason": "encrypted_or_unsupported",
      "expectedState": null,
      "note": "Compressed audio is unsupported in v1 and fails before decode."
    },
    {
      "caseId": "pdf-partial-ready",
      "family": "pdf",
      "kind": "PDF",
      "mediaType": "application/pdf",
      "byteLength": 2048,
      "pageCount": 2,
      "category": "partial",
      "interference": "partial_extraction",
      "expectedOutcome": "admitted",
      "expectedPublicReason": null,
      "expectedState": "PARTIAL_READY",
      "note": "At least one lane ready with incomplete required lanes surfaces partial_ready."
    },
    {
      "caseId": "text-duplicate-replay",
      "family": "text_markdown",
      "kind": "TEXT_MARKDOWN",
      "mediaType": "text/plain",
      "byteLength": 32,
      "category": "duplicate",
      "interference": "exact_replay",
      "expectedOutcome": "admitted",
      "expectedPublicReason": null,
      "expectedState": "ADMITTED",
      "duplicateSemantics": {
        "exactReplay": "original_outcome",
        "conflictingReuse": "rejected"
      },
      "note": "Exact authenticated replay returns original outcome; conflicting key rejects without mutation."
    },
    {
      "caseId": "png-revoked",
      "family": "png",
      "kind": "PNG",
      "mediaType": "image/png",
      "byteLength": 2048,
      "widthPx": 64,
      "heightPx": 64,
      "category": "revoked",
      "interference": "revoke_during_extraction",
      "expectedOutcome": "revoked",
      "expectedPublicReason": "not_found_or_denied",
      "expectedState": "REVOKED",
      "note": "Revoke during extraction denies status/evidence with not_found_or_denied."
    },
    {
      "caseId": "wav-purged-deleted",
      "family": "pcm_wav",
      "kind": "PCM_WAV",
      "mediaType": "audio/wav",
      "byteLength": 2048,
      "durationMillis": 500,
      "sampleRateHz": 16000,
      "channels": 1,
      "category": "deleted",
      "interference": "purge_after_revoke",
      "expectedOutcome": "purged",
      "expectedPublicReason": "not_found_or_denied",
      "expectedState": "PURGED",
      "note": "After purge, public reads are non-disclosing; only authorized purge success discloses purged."
    }
  ]
}
