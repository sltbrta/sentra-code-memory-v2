"""Authenticated Unix-socket local-authority transport and boundary tests."""

load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "localauthority",
    srcs = glob(["*.go"], exclude = ["*_test.go"]),
    importpath = "github.com/sltbrta/sentra-code-memory-v2/services/gateway/internal/localauthority",
    visibility = ["//services/gateway:__subpackages__"],
    deps = [
        "//packages/contracts/gen/go/ouroboros/contracts/v1:contracts",
        "//services/internal/contracts",
        "@build_buf_go_protovalidate//:protovalidate",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "localauthority_test",
    srcs = [
        "ingestion_test.go",
        "factory_handlers_test.go",
        "peer_darwin_test.go",
        "peer_linux_test.go",
        "query_handlers_test.go",
        "transport_test.go",
    ],
    embed = [":localauthority"],
    tags = [
        "ouroboros_affected",
        "ouroboros_check",
        "ouroboros_test",
    ],
    visibility = ["//tools/stage-02:__pkg__"],
    deps = [
        "//packages/contracts/gen/go/ouroboros/contracts/v1:contracts",
        "//services/internal/contracts",
        "@build_buf_go_protovalidate//:protovalidate",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
