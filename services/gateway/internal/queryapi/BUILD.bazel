"""Stage 04 grounded-query handlers behind the authenticated gateway boundary."""

load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "queryapi",
    srcs = [
        "doc.go",
        "handler.go",
        "map.go",
        "ports.go",
        "types.go",
        "validate.go",
    ],
    importpath = "github.com/sltbrta/sentra-code-memory-v2/services/gateway/internal/queryapi",
    visibility = ["//services/gateway:__subpackages__"],
    deps = [
