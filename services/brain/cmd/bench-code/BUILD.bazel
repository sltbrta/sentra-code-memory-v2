load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "command",
    srcs = ["main.go", "smoke.go"],
    importpath = "github.com/sltbrta/sentra-code-memory-v2/services/brain/cmd/bench-code",
    visibility = ["//visibility:private"],
    deps = [
        "//services/brain/internal/adapters",
        "//services/brain/internal/codeserve",
        "//services/brain/internal/scmbench",
    ],
)

go_binary(
    name = "bench-code",
    embed = [":command"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "command_test",
    srcs = ["main_test.go"],
    embed = [":command"],
    tags = [
        "ouroboros_affected",
        "ouroboros_check",
        "ouroboros_test",
    ],
)
