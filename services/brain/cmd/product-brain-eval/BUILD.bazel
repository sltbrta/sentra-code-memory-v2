"""Deterministic product-brain eval bridge for ERB harness (ADR 0020)."""

load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "command",
    srcs = [
        "engine.go",
        "main.go",
    ],
    importpath = "github.com/sltbrta/sentra-code-memory-v2/services/brain/cmd/product-brain-eval",
    visibility = ["//visibility:private"],
    deps = [
        "//services/brain/internal/factualconsistency",
        "//services/brain/internal/hosted",
    ],
)

go_binary(
    name = "product-brain-eval",
    embed = [":command"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "command_test",
    srcs = ["engine_test.go"],
    data = ["testdata/tiny.jsonl"],
    embed = [":command"],
    deps = ["//services/brain/internal/factualconsistency"],
    tags = [
        "ouroboros_affected",
        "ouroboros_check",
        "ouroboros_test",
    ],
)
