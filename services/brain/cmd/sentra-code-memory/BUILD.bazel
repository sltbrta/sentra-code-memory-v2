load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "command",
    srcs = [
        "adapters.go",
        "local.go",
        "main.go",
        "mlx.go",
        "watch.go",
    ],
    importpath = "github.com/sltbrta/sentra-code-memory-v2/services/brain/cmd/sentra-code-memory",
    visibility = ["//visibility:private"],
    deps = [
        "//services/brain/internal/adapters",
        "//services/brain/internal/codecrawl",
        "//services/brain/internal/codeserve",
    ],
)

go_binary(
    name = "sentra-code-memory",
    embed = [":command"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "command_test",
    srcs = [
        "adapters_test.go",
        "cli_local_test.go",
        "main_memory_test.go",
        "main_test.go",
        "scip_recall_test.go",
    ],
    embed = [":command"],
    deps = [
        "//services/brain/internal/adapters",
    ],
)
