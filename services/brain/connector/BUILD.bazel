"""Active connector-owned public composition boundary."""

load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "connector",
    srcs = ["connector.go"],
    importpath = "github.com/sltbrta/sentra-code-memory-v2/services/brain/connector",
    visibility = ["//services:__subpackages__"],
    deps = [
        "//packages/contracts/gen/go/ouroboros/contracts/v1:contracts",
        "//services/brain/internal/connector",
    ],
)

go_test(
    name = "connector_test",
    srcs = ["connector_test.go"],
    embed = [":connector"],
    deps = ["//packages/contracts/gen/go/ouroboros/contracts/v1:contracts"],
)
