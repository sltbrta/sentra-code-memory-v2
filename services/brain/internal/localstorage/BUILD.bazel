"""Durable Stage 02 local metadata adapter targets."""

load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "localstorage",
    srcs = [
        "artifact.go",
        "artifact_queries.go",
        "bundle.go",
        "doc.go",
        "evidence.go",
        "executor.go",
        "keychain_darwin.go",
        "keys.go",
